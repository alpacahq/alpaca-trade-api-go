.envrc

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, build with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out
.vscode
.idea
vendor

# Temp directory
tmp/

# Verified generated SDK tool cache
tools/generated-sdk/.cache/

# Recoverable generated SDK specification adoption state
tools/generated-sdk/.transactions/
